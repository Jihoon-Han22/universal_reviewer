{
  "name": "universal-reviewer-local",
  "main": ".cache/sites-output/server/index.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": ".cache/sites-output/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "universal-reviewer-local", "database_id": "00000000-0000-4000-8000-000000000000"}],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "universal-reviewer-local"}]
}

{
  "formatVersion": 1,
  "description": "Model response JSON schemas. These are transport schemas, not sufficient validation: enforce the size, provenance, geometry, coverage and semantic rules in specs/02-backend-pipeline.md and specs/03-algorithms.md.",
  "documentContextSchema": {
    "type": "object",
    "required": [
      "summary",
      "documentType",
      "structure",
      "warnings",
      "questions"
    ],
    "properties": {
      "summary": {
        "type": "string"
      },
      "documentType": {
        "type": "string"
      },
      "structure": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "kind",
            "description",
            "headers",
            "orientation",
            "uncertain"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "table",
                "text",
                "metadata",
                "image",
                "list",
                "other"
              ]
            },
            "sheet": {
              "type": "string"
            },
            "page": {
              "type": "integer"
            },
            "range": {
              "type": "string"
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "string"
            },
            "orientation": {
              "type": "string",
              "enum": [
                "horizontal",
                "vertical",
                "mixed",
                "unknown"
              ]
            },
            "uncertain": {
              "type": "boolean"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "questions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "documentFieldsSchema": {
    "type": "object",
    "required": [
      "referenceNumber",
      "documentType",
      "fields",
      "warnings"
    ],
    "properties": {
      "referenceNumber": {
        "type": "string"
      },
      "documentType": {
        "type": "string"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "fields": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "label",
            "value",
            "unit",
            "uncertain",
            "evidence"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "uncertain": {
              "type": "boolean"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "documentId",
                  "quote"
                ],
                "properties": {
                  "documentId": {
                    "type": "string"
                  },
                  "page": {
                    "type": "integer"
                  },
                  "sheet": {
                    "type": "string"
                  },
                  "cell": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "visualTranscriptionSchema": {
    "type": "object",
    "required": [
      "pages",
      "warnings"
    ],
    "properties": {
      "warnings": {
        "type": "array",

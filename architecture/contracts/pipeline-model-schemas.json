                      "type": "string"
                    }
                  },
                  "cells": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "row",
                        "column",
                        "rowSpan",
                        "colSpan",
                        "text",
                        "uncertain"
                      ],
                      "properties": {
                        "row": {
                          "type": "integer"
                        },
                        "column": {
                          "type": "integer"
                        },
                        "rowSpan": {
                          "type": "integer"
                        },
                        "colSpan": {
                          "type": "integer"
                        },
                        "text": {
                          "type": "string"
                        },
                        "uncertain": {
                          "type": "boolean"
                        },
                        "childTableIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

{
  "schemaVersion": 1,
  "title": "Current-reproduction algorithm cases and separately optional future proposals",
  "executionStatus": "not_executed_against_rebuild",
  "semantics": {
    "baseline": "CURRENT_REPRODUCTION oracle: reproduce the observed implementation, including documented limits. A baseline pass is not proof of safety or of every possible input.",
    "additionalAcceptance": "OPTIONAL_FUTURE only. Historical mode additional-acceptance is retained for compatibility. These proposed corrections and semantic probes are excluded from CURRENT_REPRODUCTION gates and scores and must not override its baseline oracle.",
    "matching": "Expected fields are a deep partial projection unless omittedProperties, exact list or explicit matching policy is supplied. No undeclared text equality for model prose.",
    "modelCalls": "Model-stub baseline operations use test doubles. real-model/ModelSemanticAcceptance operations require captured actual request/response and source-bound validation, never a keyword-only substitute.",
    "fixtureIndependence": "Each case deep-clones its input. Mutation checks compare object identities only inside the named operation. No production keys/data included.",
    "eligibilityCapture": "For assessCriteriaDocument-real-model, record every real generateJson response as rawModelCaptures. Compare expected.rawModel with the final successfully validated model payload and expected.publicAssessment with the returned public DTO. hasNormativeContent belongs only to the raw model schema; public assessment omits it. A timeout, provider error, or malformed response yielding uncertain does not satisfy a semantic uncertain fixture. No credentials are recorded.",
    "profileSelection": "Default CURRENT_REPRODUCTION selects only profile CURRENT_REPRODUCTION / mode baseline. OPTIONAL_FUTURE requires a separate explicit scope choice. No product code or required prompt overlays are implied by the future cases."
  },
  "sourceContracts": [
    "specs/03-algorithms.md",
    "prompts/pipeline-prompts.md"
  ],
